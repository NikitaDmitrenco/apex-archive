# Apex Archive — environment variables template.
# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection used by the app at runtime.
# Supabase dashboard -> Connect -> Connection string.
# Use the SESSION POOLER (port 5432), NOT the transaction pooler (6543).
# postgres.js pipelines concurrent queries on one connection and transaction mode cannot
# interleave them, so any page issuing several queries at once hangs until the server's
# statement timeout fires. See the comment in lib/db/index.ts.
DATABASE_URL=

# Unpooled connection used by drizzle-kit migrations and the seed script, which run DDL
# and want a stable session.
# Use the SESSION POOLER string (same host as above, port 5432). Supabase's true direct
# connection, db.<project-ref>.supabase.co, resolves over IPv6 only and fails with
# ENOTFOUND on an IPv4-only network.
# Optional: if unset, drizzle-kit falls back to DATABASE_URL.
DIRECT_URL=

# Supabase project URL and public anon key (Project Settings -> API).
# Safe to expose to the browser. Needed once media moves to Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, bypasses row level security.
# NEVER expose this to the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL, used for metadata and Open Graph absolute URLs.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# OpenAI API key — only needed for the optional AI Archive Assistant (Milestone 14).
# Leave empty until then.
OPENAI_API_KEY=
